{
  "name": "opencode-stats",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Statistics and system-prompt viewer plugin for OpenCode: tok/s gauge, rate history, turn/session metrics and the composed system prompt, over a SolidJS side panel (./gui-experimental).",
  "exports": {
    ".": {
      "import": "./index.ts"
    },
    "./gui-experimental": {
      "import": "./dist/gui-experimental.cjs"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:gui": "tsc --noEmit -p tsconfig.gui.json",
    "gui:build": "vite build",
    "gui:watch": "vite --watch"
  },
  "dependencies": {
    "opencode-shared": "github:HitalloExiled/opencode-shared#bd315496f9c1ab8c67f3d56ecee342dc85e904f4"
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.0",
    "@opencode/schema": "2.2.0",
    "@types/node": "24.12.2",
    "effect": "4.0.1",
    "solid-js": "1.9.18",
    "typescript": "5.8.2",
    "vite": "5.4.17",
    "vite-plugin-solid": "2.11.15"
  }
}
